  "license": "BSD-3-Clause",
  "dependencies": {
    "com.unity.burst": "1.8.29",
    "com.unity.collections": "2.6.7",
    "com.unity.mathematics": "1.3.3",
    "com.unity.timeline": "1.8.12",
    "com.unity.ugui": "2.0.0"
  },
  "keywords": [
    "spritestudio",
    "optpix",
    "2d",
    "animation",
